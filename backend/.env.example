# Copy to .env for local development. Never commit the real .env file.

# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (dj-database-url format). SQLite for dev/test, Postgres in prod (NFR-03).
DATABASE_URL=sqlite:///db.sqlite3

# Session/CSRF cookies (NFR-04). Secure cookies require HTTPS - set to False
# only when running plain HTTP locally (e.g. next dev + manage.py runserver).
COOKIE_SECURE=False

# Comma-separated list of trusted HTTPS origins for CSRF (prod only).
CSRF_TRUSTED_ORIGINS=
