# Copy to .env for local development. Never commit the real .env file.

# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (dj-database-url format). SQLite for dev/test, Postgres in prod (NFR-03).
DATABASE_URL=sqlite:///db.sqlite3

# Session/CSRF cookies (NFR-04). Secure cookies require HTTPS - set to False
# only when running plain HTTP locally (e.g. next dev + manage.py runserver).
COOKIE_SECURE=False

# Comma-separated list of origins CSRF trusts as the request's Origin
# (design.md §4). In prod this is the single public https origin. In dev it
# must also include http://localhost:3000: Next's rewrite proxy
# (next.config.ts) forwards requests to Django with Host: 127.0.0.1:8000,
# so Django's own same-origin Origin check (`request.scheme + get_host()`)
# never matches the browser's real http://localhost:3000 Origin header —
# without this, every authenticated unsafe request (anything past
# signup/login, which DRF exempts from CSRF while the session is anonymous)
# 403s with "CSRF Failed: Origin checking failed" the first time a logged-in
# user does a POST/PATCH/DELETE through the dev proxy.
CSRF_TRUSTED_ORIGINS=http://localhost:3000
